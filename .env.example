# Primer konfiguracije — iskopiraj u `.env` i popuni.
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` je u .gitignore i NIKADA se ne commit-uje.

# --- Autentifikacija ---
# Ključ za potpisivanje JWT-a. Minimum 32 karaktera; app odbija da radi bez
# njega (ranije je bio hardkodovan fallback, što je značilo da svako može da
# iskuje važeći admin token).
# Generiši: openssl rand -hex 32
AUTH_SECRET=

# --- Baza ---
# Lozinka role `blowing`. Koristi se i za app i za `docker compose` initdb.
# Generiši: openssl rand -hex 24
DB_PASSWORD=

# --- Početni admin (samo ako je tabela `users` prazna) ---
ADMIN_EMAIL=admin@example.com
# Generiši: openssl rand -base64 18 | tr -d '/+='
ADMIN_PASSWORD=
